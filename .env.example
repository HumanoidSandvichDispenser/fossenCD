# Copy to .env (gitignored). Everything here is optional; the defaults in
# docker-compose.yml apply when a line stays commented out.

# Build args for the backend image: where the eg binary comes from.
# EG_SOURCE=git (default) builds okayeg from its git remote at OKAYEG_REV;
# EG_SOURCE=local skips that build and expects the runtime bind below.
#FOSSENCD_EG_SOURCE=git
#OKAYEG_REV=1da42e41857d0baee7a3c1acf7822deaaf91f195

# Local okayeg iteration: load the override that binds host-built artifacts
# into the containers. Copy docker-compose.local.yml.example to
# docker-compose.local.yml first, then uncomment all three lines.
#COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
#FOSSENCD_EG_BIN_HOST=../okayeg/target/debug/eg
#FOSSENCD_OKAYEG_WASM=../okayeg/crates/okayeg-wasm/pkg
