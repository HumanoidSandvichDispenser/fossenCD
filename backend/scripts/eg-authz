#!/bin/sh
# The authz hook each project's .eg/config.toml names. eg runs it per incoming
# connection with the peer's endpoint id on stdin; the verdict goes to stdout.
#
#   eg-authz <socket> <project-id>
#
# It forwards the decision to the fossencd backend over its authz unix socket.
# A 200 grants: its body ("pull push") is the verdict. A 403 refuses: eg reads
# any non-grant first line as a refusal, so we print "deny" then the backend's
# reason body, which eg relays to the dialer. A connection failure (down backend,
# missing socket) exits nonzero, which eg also reads as a refusal, so the gate
# fails closed.
set -eu
read -r peer || exit 1

body=$(mktemp)
trap 'rm -f "$body"' EXIT
code=$(curl -s -o "$body" -w '%{http_code}' --unix-socket "$1" "http://authz/projects/$2/peers/$peer") || exit 1

if [ "$code" = "200" ]; then
	cat "$body"
else
	printf 'deny\n'
	cat "$body"
fi
